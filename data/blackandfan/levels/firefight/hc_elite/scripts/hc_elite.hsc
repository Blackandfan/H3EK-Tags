;========================================|
;============Global Variables============|
;========================================|

(global boolean debugmode FALSE)
(global boolean wavedone FALSE)
(global boolean Endless_Wave FALSE)

;====Starting Fade In====|
(script startup start
    (game_safe_to_respawn TRUE)
    (print_difficulty)
    (if (game_is_cooperative)
            (begin
                (print "game is coop")
            )
            (begin
                (print "game is singleplayer")
            )
    )
    (sound_looping_start levels\solo\070_waste\music\070_music_085 NONE 1)
    (sleep 2)
    (print "wait for initial enemies")
)

(script static boolean (more_than_x_ai (ai squad) (short count))
    (> (ai_living_count allsquads) count)
)

(script continuous kill_counting
    (if (more_than_x_ai allsquads 0)
        (begin 
            (set wavedone FALSE)
        )
        (begin 
            (set wavedone TRUE)
        )
    )
)

(script continuous elites_support
    (if (<= (ai_nonswarm_count "elites_count") 0)
        (begin
            (ai_place "elites")
            (print "Respawning elites.")
            (sleep 750)
        )
    )
)

(script continuous debug
    (if 
        (and 
            (= debugmode TRUE)
            (<= (ai_nonswarm_count "chief_debug") 0)
        )
        (begin
            (ai_place "chief_debug")
            (print "Respawning chief_debug.")
            (sleep 250)
        )
    )
)

(script continuous round0
    (if (<= (ai_nonswarm_count "cov_bastards") 1)
        (begin 
            (wake round1)
            (print "starting the game")
            (sleep_forever)
        )
    )
)

(script static void (player_dervish (object a_player) (string str))
    (override_player_representation_index 1)
    (print str)
)

(script startup dervish
    (player_dervish (list_get (players) 0) "player 1 is now arbiter")
)

;====================================================|
;========================Waves=======================|
