;========================================|
;============Global Variables============|
;========================================|

(global boolean debugmode FALSE)
(global boolean wavedone FALSE)
(global boolean Endless_Wave FALSE)
(global short player_lifes 5)



;====Starting Fade In====|
(script startup start
    (game_safe_to_respawn TRUE)
    (ai_enable FALSE)
    (print "AI disabled.")
    (if (game_is_cooperative)
            (begin
                (print "game is coop")
                (ai_place "2player_ally")
            )
            (begin
                (print "game is singleplayer")
                (ai_place "1player_ally")
                (ai_place "2player_ally")
            )
    )
    (sound_looping_start levels\solo\070_waste\music\070_music_085 NONE 1)
    (sleep 2)
    (wake round1)
)

(script continuous playerentersplayarea
    (if (volume_test_players playable)
        (begin
            (ai_enable TRUE)
            (print "AI enabled.")
            (ai_place "initially_placed_ene")
            (sleep_forever)
        )
    )
)

(script continuous debug
    (if 
        (and 
            (= debugmode TRUE)
            (< (ai_nonswarm_count "debugsquad") 1)
        )
        (begin
            (ai_place "debugsquad")
            (print "Respawning debugsquad.")
            (sleep 250)
        )
    )
)

(script continuous kill_player_in_zone
  (if (volume_test_object kill_volume (list_get (players) 0))
    (unit_kill (unit (list_get (players) 0)))
  )
  (if (volume_test_object kill_volume (list_get (players) 1))
    (unit_kill (unit (list_get (players) 1)))
  )
  (if (volume_test_object kill_volume (list_get (players) 2))
    (unit_kill (unit (list_get (players) 2)))
  )
  (if (volume_test_object kill_volume (list_get (players) 3))
    (unit_kill (unit (list_get (players) 3)))
  )
)

(script static boolean (more_than_x_ai (ai squad) (short count))
    (> (ai_living_count allsquads) count)
)

(script continuous kill_counting
    (if (more_than_x_ai allsquads 0)
        (begin 
            (set wavedone FALSE)
        )
        (begin 
            (set wavedone TRUE)
        )
    )
)

(script continuous track_lifes
    (if (game_reverted)
        (begin 
        (print "one life lost")
        (set player_lifes (- player_lifes 1))
        (sleep 300)
        (game_lost TRUE)
        )
    )
)

;====================================================|
;========================Waves=======================|
